{
  "name": "cypress-start",
  "version": "1.3.2",
  "description": "Cypress testing framework starter - Professional test automation framework template with comprehensive structure, documentation, and best practices",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanZdanovich/cypress-start.git"
  },
  "bin": {
    "cypress-start": "bin/cypress-start.js",
    "create-cypress-start": "bin/cypress-start.js"
  },
  "files": [
    "bin/",
    "cypress/e2e/",
    "cypress/integration/",
    "cypress/support/",
    "cypress/integration-test-data/",
    "cypress/sensitive-data/env-users.example.json",
    "cypress/reports/mochawesome/.gitkeep",
    "cypress/reports/screenshots/.gitkeep",
    "docs/",
    "bug-log/",
    "development-data/",
    "eslint-plugin-custom-rules/",
    "scripts/",
    ".github/copilot-instructions.md",
    ".github/instructions/",
    ".github/FUNDING.yml",
    "assets/",
    "cypress.config.js",
    "eslint.config.mjs",
    "Dockerfile",
    ".gitignore",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "node scripts/copy-localization.js && node scripts/copy-colours-theme.js",
    "test": "cypress run --headless",
    "test:parallel": "node scripts/parallel-cypress-runner.js",
    "lint": "eslint . --format stylish --fix",
    "hooks:setup": "node scripts/setup-git-hooks.js",
    "postinstall": "node scripts/setup-git-hooks.js",
    "check:unused": "eslint cypress/support/selectors/selectors.js cypress/support/localization/l10n.json",
    "update-swagger": "node scripts/update-swagger-schemas.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "node scripts/check-eslint.js"
    ]
  },
  "private": false,
  "keywords": [
    "cypress",
    "testing",
    "framework",
    "template",
    "starter",
    "boilerplate",
    "test-automation",
    "e2e",
    "integration-testing",
    "ui-testing",
    "api-testing",
    "cypress-framework",
    "cypress-template",
    "test-framework"
  ],
  "author": "Ivan Zdanovich",
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-cypress": "^6.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.6",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "cypress": "^15.11.0",
    "mochawesome": "^7.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
